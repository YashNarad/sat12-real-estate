# Browser-safe values from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project identity and safety confirmations (keep actual values in ignored local env files)
SUPABASE_PROJECT_REF=
SAT12_APPROVED_PROJECT_REF=
SAT12_DEVELOPMENT_DATA_CONFIRMED=false

# Operational secrets: use .env.supabase.local or an OS secret manager, never commit
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set transiently only after approving one exact remote mutation, e.g. migrate:<project-ref>
SAT12_REMOTE_OPERATION_APPROVED=
