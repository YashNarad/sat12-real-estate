{
  "name": "sat12-real-estate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db:cloud": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/run-cloud-db-tests.mjs",
    "test:storage:cloud": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/storage-api-tests.mjs",
    "supabase:target": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/assert-supabase-target.mjs",
    "supabase:migrations:preview": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/run-supabase-migrations.mjs preview",
    "supabase:migrations:apply": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/run-supabase-migrations.mjs apply",
    "supabase:fixtures": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/seed-cloud-fixtures.mjs",
    "supabase:storage-fixtures": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/seed-property-images.mjs",
    "supabase:types:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/check-database-types.mjs",
    "supabase:bootstrap-admin": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/bootstrap-admin.mjs",
    "supabase:cleanup-mfa-factor": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.supabase.local scripts/cleanup-mfa-factor.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
